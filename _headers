# ============================================================
# Cloudflare Pages 靜態資源層響應標頭
# ------------------------------------------------------------
# 只對 Cloudflare Pages 靜態資源（HTML/JS/CSS/圖片）生效，
# 不影響 Pages Functions 的 API 回應（Functions 由 cors.js 模組注入）。
# ============================================================

# ── Service Worker 腳本每次向原站驗證 ──
# 瀏覽器以位元組比對決定是否安裝新版 SW，一旦 sw.js 被瀏覽器或
# 中繼層長快取，已部署的修復會永遠卡在 waiting。
# no-cache = 使用前必須驗證（允許 304），非 no-store。
/sw.js
  Cache-Control: no-cache, must-revalidate

# ── 靜態資源快取 ──
# 專案目前沒有 build + content hash 機制（package.json 無 build 腳本），
# 所有 JS/CSS 檔名固定（system.js / chat_module.js / style.css ...）。
# 若設長快取，安全修復最長一年送不到舊用戶端（含 SW 背景更新也會
# 命中瀏覽器舊快取）。因此 JS/CSS 先用 no-cache 強制向原站驗證（允許
# 304，Cloudflare Pages 自產 ETag，效能影響極小）。未來上 hash 檔名後
# 可改回 immutable。圖片內容很少變且非安全風險，保留長快取。
/*.js
  Cache-Control: no-cache, must-revalidate
/*.css
  Cache-Control: no-cache, must-revalidate
/images/*
  Cache-Control: public, max-age=31536000, immutable

# ── HTML 檔案：每次向原站驗證 ──
# HTML 引用的 JS/CSS 檔名會變，但 HTML 本身要快取最新版本，
# 確保不會因瀏覽器快取舊 HTML 而引用已不存在的新 hash 檔案。
/*.html
  Cache-Control: no-cache, must-revalidate

# ── 全站安全響應標頭 ──
# 應用於所有路徑（含 HTML/JS/CSS/圖片），Functions API 另有 cors.js 補充。
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  X-Download-Options: noopen
  # HSTS（Strict-Transport-Security）強制 HTTPS 一年
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Content-Security-Policy（report-only 模式，先收集再強制）
  # 之後可移除 -report-only 切換到強制執行
  Content-Security-Policy-Report-Only:
    default-src 'self';
    script-src 'self' 'unsafe-inline' https://www.gstatic.com https://*.cloudflareinsights.com https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com;
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com;
    img-src 'self' data: blob: https:;
    font-src 'self' https://fonts.gstatic.com data:;
    connect-src 'self' https://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://oauth2.googleapis.com https://fcm.googleapis.com https://challenges.cloudflare.com https://*.agora.io https://*.agoraio.cn https://www.googleapis.com;
    frame-src 'self' https://challenges.cloudflare.com;
    frame-ancestors 'none';
    object-src 'none';
    base-uri 'self';
    form-action 'self';
